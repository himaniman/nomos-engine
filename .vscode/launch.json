{
  // F5 launch configs for the vivarium playground (and nomos).
  // All use the project's .venv interpreter explicitly, so they work no matter
  // which interpreter VS Code has selected.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "vivarium: watch (pygame)",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.app",
      "args": ["--size", "96", "--seed", "1", "--cell", "7"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "vivarium: watch NCA brains (pygame)",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.app",
      "args": ["--brain", "nca", "--size", "48", "--seed", "1", "--cell", "12",
               "--population", "25"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "vivarium: watch NCA brains (continue from session)",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.app",
      "args": ["--brain", "nca", "--size", "48", "--seed", "1", "--cell", "12",
               "--population", "25",
               "--load-genomes", "vivarium/pools/session.json",
               "--save-genomes", "vivarium/pools/session.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "vivarium: headless NCA run",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.run",
      "args": ["--brain", "nca", "--size", "48", "--seed", "1",
               "--population", "25", "--wall-density", "0",
               "--ticks", "4000", "--every", "250"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "vivarium: watch seeded (from pool)",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.app",
      "args": ["--seed", "5", "--cell", "7",
               "--load-genomes", "vivarium/pools/open_evolved.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "vivarium: headless run",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.run",
      "args": ["--ticks", "8000", "--every", "500", "--seed", "1"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "vivarium: evolve open + save pool",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.run",
      "args": ["--ticks", "12000", "--every", "1000", "--seed", "1",
               "--wall-density", "0",
               "--save-genomes", "vivarium/pools/open_evolved.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "aqua: watch continuous NCA (pygame)",
      "type": "debugpy",
      "request": "launch",
      "module": "aqua.app",
      "args": ["--brain", "nca", "--size", "48", "--seed", "1", "--cell", "12",
               "--population", "18"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "aqua: watch continuous NEAT (pygame)",
      "type": "debugpy",
      "request": "launch",
      "module": "aqua.app",
      "args": ["--brain", "neat", "--size", "48", "--seed", "1", "--cell", "12",
               "--population", "18"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "aqua: watch continuous NCA (continue from session)",
      "type": "debugpy",
      "request": "launch",
      "module": "aqua.app",
      "args": ["--brain", "nca", "--size", "48", "--seed", "1", "--cell", "12",
               "--population", "18",
               "--load-genomes", "aqua/pools/session.json",
               "--save-genomes", "aqua/pools/session.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // PLAY the cortex world yourself (stage 1: walk around, no senses/food yet).
      // W/Up thrust, A/D turn, SPACE pause, P screenshot, H help, ESC quit.
      "name": "cortex: PLAY the world (keyboard)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--seed", "1", "--view", "65", "--cell", "12"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // a wider, zoomed-out view — good for judging the GENERATOR rather than playing
      "name": "cortex: PLAY (wide view, seed 4)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--seed", "4", "--view", "101", "--cell", "8"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // the generator is infinite-capable; --size 0 unbounds it (walk forever)
      "name": "cortex: PLAY (unbounded world)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--seed", "1", "--view", "65", "--cell", "12", "--size", "0"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "cortex: tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/test_cortex.py", "-q"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    }
  ]
}
