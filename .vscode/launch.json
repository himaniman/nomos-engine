{
  // F5 launch configs for the vivarium playground (and nomos).
  // All use the project's .venv interpreter explicitly, so they work no matter
  // which interpreter VS Code has selected.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "vivarium: watch (pygame)",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.app",
      "args": ["--size", "96", "--seed", "1", "--cell", "7"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "vivarium: watch NCA brains (pygame)",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.app",
      "args": ["--brain", "nca", "--size", "48", "--seed", "1", "--cell", "12",
               "--population", "25"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "vivarium: watch NCA brains (continue from session)",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.app",
      "args": ["--brain", "nca", "--size", "48", "--seed", "1", "--cell", "12",
               "--population", "25",
               "--load-genomes", "vivarium/pools/session.json",
               "--save-genomes", "vivarium/pools/session.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "vivarium: headless NCA run",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.run",
      "args": ["--brain", "nca", "--size", "48", "--seed", "1",
               "--population", "25", "--wall-density", "0",
               "--ticks", "4000", "--every", "250"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "vivarium: watch seeded (from pool)",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.app",
      "args": ["--seed", "5", "--cell", "7",
               "--load-genomes", "vivarium/pools/open_evolved.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "vivarium: headless run",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.run",
      "args": ["--ticks", "8000", "--every", "500", "--seed", "1"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "vivarium: evolve open + save pool",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.run",
      "args": ["--ticks", "12000", "--every", "1000", "--seed", "1",
               "--wall-density", "0",
               "--save-genomes", "vivarium/pools/open_evolved.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "aqua: watch continuous NCA (pygame)",
      "type": "debugpy",
      "request": "launch",
      "module": "aqua.app",
      "args": ["--brain", "nca", "--size", "48", "--seed", "1", "--cell", "12",
               "--population", "18"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "aqua: watch continuous NEAT (pygame)",
      "type": "debugpy",
      "request": "launch",
      "module": "aqua.app",
      "args": ["--brain", "neat", "--size", "48", "--seed", "1", "--cell", "12",
               "--population", "18"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "aqua: watch continuous NCA (continue from session)",
      "type": "debugpy",
      "request": "launch",
      "module": "aqua.app",
      "args": ["--brain", "nca", "--size", "48", "--seed", "1", "--cell", "12",
               "--population", "18",
               "--load-genomes", "aqua/pools/session.json",
               "--save-genomes", "aqua/pools/session.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // PLAY the cortex world yourself (stage 1: walk around, no senses/food yet).
      // W/Up thrust, A/D turn, SPACE pause, P screenshot, H help, ESC quit.
      "name": "cortex: PLAY the world (keyboard)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--seed", "2", "--view", "65", "--cell", "12"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // a wider, zoomed-out view — good for judging the GENERATOR rather than playing
      "name": "cortex: PLAY (wide view, seed 4)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--seed", "4", "--view", "101", "--cell", "8"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // the generator is infinite-capable; --size 0 unbounds it (walk forever)
      "name": "cortex: PLAY (unbounded world)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--seed", "1", "--view", "65", "--cell", "12", "--size", "0"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // WATCH A BRAIN PLAY. B hands the wheel between you and it, V cycles the sheet
      // view, T animates the sub-ticks, - and = change WORLD SPEED (1/20x .. 8x) —
      // slow it right down to watch a thought cross the tissue. Click a cell to open
      // the perceptron behind it.
      "name": "cortex: WATCH a brain play",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--seed", "2", "--view", "65", "--cell", "11", "--brain",
               "--brain-seed", "0", "--think-every", "30"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // *** WATCH A BRAIN WITH ITS INNATE REFLEXES ***  The arcs it is born knowing:
      // smell-forward -> thrust, smell-lateral -> turn, smell-right-here -> eat, each
      // carried from the nose organs to the effectors by a PIONEER TRACT. In the brain
      // column the tracts are part of the green web and the header says how many are
      // innate. Press R for the TRACK — a brain that forages draws a line to its food
      // instead of a closed loop. Slow the world with - to watch a thought cross.
      "name": "cortex: WATCH a REFLEX brain play",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--seed", "2", "--view", "65", "--cell", "11", "--brain",
               "--brain-seed", "2", "--think-every", "3"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // ...and the SAME brain with the whole innate arc stripped out — the ablation
      // arm, made watchable. Run this beside the one above: if they look alike, the
      // reflex is not doing the work we think it is.
      "name": "cortex: WATCH the same brain WITHOUT reflexes (ablation)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--seed", "2", "--view", "65", "--cell", "11", "--brain",
               "--brain-seed", "2", "--think-every", "3", "--no-reflex"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // do the arcs help, and does the TISSUE add anything on top of them? Three arms:
      // the brain as it lived, the brain with the arc removed, and the twenty-line
      // reflex policy with no brain at all. The third is what stops us fooling
      // ourselves that a decorative brain riding a reflex has learnt something.
      "name": "cortex: REFLEX ablation (do the innate arcs earn their keep?)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.cradle",
      "args": ["--reflex", "--world", "real", "--seeds", "0,1,2,3,4,5",
               "--ticks", "2500", "--probe-ticks", "300"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // LEARNING x REFLEX, four arms. Does within-life learning contribute now that
      // the innate arcs make eating a CONSEQUENCE of a behaviour — and does it need
      // them to? The learning delta is measured twice, once with the arcs and once
      // without. If it is the same either way, the reflexes bought foraging and the
      // correlation argument for them was wrong.
      "name": "cortex: LEARNING x REFLEX matrix",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.cradle",
      "args": ["--matrix", "--world", "real", "--seeds", "0,1,2,3,4,5",
               "--ticks", "2500", "--probe-ticks", "300"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // *** THE CRADLE ***  Does within-life learning contribute ANYTHING, given
      // reward that actually arrives? A small world thick with food — a bench, not a
      // benchmark, no score from it counts. The answer comes from an ABLATION: one
      // brain at the end of its life, sat at the exams twice, once with what it
      // learned and once with the deltas wiped and the body identical. Read the DELTA
      // row; it is learning with growth held fixed.
      "name": "cortex: CRADLE (does learning do anything?)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.cradle",
      "args": ["--seeds", "0,1,2", "--ticks", "2500", "--probe-ticks", "300"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // the two TIME CONSTANTS of learning, swept against how often the world rewards.
      // Credit has to survive as long as an approach and no longer.
      "name": "cortex: CRADLE — sweep the learning time constants",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.cradle",
      "args": ["--sweep", "--seeds", "0,1,2", "--ticks", "2500",
               "--probe-ticks", "300"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // *** THE LLM LAB ***  The model writes the brain's GROWTH PROGRAM between
      // lives — never a weight — and every candidate is grown from the same fixed
      // random weights, so a score difference is attributable to the program.
      // Needs WAVESPEED_API_KEY in .env (see nomos/llm.py).
      // Each iteration writes a HUD SCREENSHOT and a probe strip into
      //   out/cortex/lab/<timestamp>/     — open gallery.png to watch the run,
      //                                     journal.md to read what it argued.
      "name": "cortex: LLM LAB (model writes the growth program)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.lab",
      "args": ["--iterations", "10", "--seeds", "0,1", "--ticks", "4000"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // the CONTROL ARM: the identical loop with a random program mutation in the
      // model's chair. "Is the LLM better than chance at writing growth programs" is
      // a question this harness should answer, not assume. No API key needed.
      "name": "cortex: LLM LAB — rng control arm",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.lab",
      "args": ["--proposer", "rng", "--iterations", "10", "--seeds", "0,1",
               "--ticks", "4000"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // a quick one to check the wiring before spending a real run
      "name": "cortex: LLM LAB (quick, 3 iterations)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.lab",
      "args": ["--iterations", "3", "--seeds", "0", "--ticks", "1500",
               "--probe-ticks", "300"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // WATCH the program the lab settled on. Point --load-brain at the genome the
      // run saved; R shows the TRACK it has walked, which is how a circler gives
      // itself away at a glance.
      "name": "cortex: WATCH the lab's best program",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--seed", "2", "--view", "65", "--cell", "11",
               "--load-brain", "out/cortex/lab/best_genome.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // EVOLVE a lineage: one agent, one long life at a time, genome carried forward
      "name": "cortex: LINEAGE (evolve a brain)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.lineage",
      "args": ["--generations", "12", "--seeds", "0-1", "--ticks", "12000",
               "--think-every", "3"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // watch the best evolved brain play
      "name": "cortex: WATCH the best brain",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--seed", "2", "--view", "65", "--cell", "11",
               "--load-brain", "out/cortex/best_genome.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // WALK A PROBE ARENA YOURSELF — the same situation the observer scores, live and
      // with the full HUD. Change --probe to corner / door / rubble / poison / patience.
      "name": "cortex: WALK a probe arena",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--probe", "corner", "--view", "33", "--cell", "16", "--no-log"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // ...and watch the BRAIN sit the same exam, with its sheet beside it
      "name": "cortex: WATCH a brain in a probe arena",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--probe", "poison", "--view", "33", "--cell", "16", "--no-log",
               "--load-brain", "out/cortex/best_genome.json", "--think-every", "3"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // SCORE a player on all six probes and write the strip to out/cortex/probes.png
      "name": "cortex: PROBES (reflex baseline)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.probes",
      "args": ["--player", "reflex"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "cortex: PROBES (best evolved brain)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.probes",
      "args": ["--player", "brain", "--load-brain", "out/cortex/best_genome.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // the BASELINE the brain has to beat: a twenty-line reflex, senses only
      "name": "cortex: baseline reflex (8 seeds)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.baseline",
      "args": ["--agent", "reflex", "--seeds", "0-7", "--ticks", "30000"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // the FLOOR: a correlated random walk
      "name": "cortex: baseline random (8 seeds)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.baseline",
      "args": ["--agent", "random", "--seeds", "0-7", "--ticks", "30000"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // play with the map hidden — the sensorium completeness test
      "name": "cortex: PLAY BLIND (senses only)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--seed", "2", "--view", "65", "--cell", "12", "--blind"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // ================= THE ATLAS (branch cortex-atlas) =================
      // *** WATCH THE ATLAS PLAY ***  The map brain: the lattice is a map around the
      // agent (right column), senses paint where they refer to, a value wave plans
      // the walk. R = the track, - and = world speed, ESC quit.
      "name": "atlas: WATCH it play (hand wave)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--atlas", "--seed", "7", "--view", "65", "--cell", "11"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // the same atlas driven by a nomos LAW instead of the numpy wave. Swap --law
      // for laws/atlas_wave.nomos (the plain wave), laws/atlas_habit.nomos, or a law
      // the lab wrote (out/cortex/law_lab/<run>/best.nomos). Seed 7 is the world
      // where the plain wave paced a wall for ever and the ghost law eats 19.
      "name": "atlas: WATCH it play on a LAW (ghost)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--atlas", "--law", "laws/atlas_ghost.nomos", "--seed", "7",
               "--view", "65", "--cell", "11"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // world 9: rooms behind doors — the door experiment's world
      "name": "atlas: WATCH world 9 (doors)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--atlas", "--seed", "9", "--view", "65", "--cell", "11"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // watch the atlas sit a probe: door / rubble / corner / maze / poison / patience
      "name": "atlas: WATCH it in a probe arena (door)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--atlas", "--probe", "door", "--view", "33", "--cell", "16", "--no-log"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // the probe LADDER (an observer, never a fitness) + the strip out/cortex/atlas/probes.png
      "name": "atlas: PROBES (ladder)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.atlas",
      "args": ["--probes"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // open-world LIVES, 8 worlds in parallel, plus a GIF of the first
      "name": "atlas: LIVES 0-7 (+ GIF of seed 0)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.atlas",
      "args": ["--seeds", "0-7", "--ticks", "8000", "--jobs", "8",
               "--gif", "out/cortex/atlas/seed0.gif"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // the poison LESSON: the same brain in the poison arena twice; one burn and it refuses the nightcap
      "name": "atlas: the poison lesson",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.atlas",
      "args": ["--poison"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // a LAW on the ladder and on lives (the rule as a nomos law, cortex/atlas_law.py)
      "name": "atlas LAW: ladder + lives 0-7",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.atlas_law",
      "args": ["laws/atlas_ghost.nomos", "--ladder", "--lives", "0-7", "--ticks", "8000",
               "--jobs", "8"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // *** THE LAW LAB ***  A model rewrites the atlas's RULE as a nomos law; every
      // candidate lives the same 8 worlds, finalists re-lived on the holdout.
      // --proposer files = YOUR laws through the same loop (no API); rng = the control;
      // llm = the model (needs a key or a local model in .env — ask before spending).
      // Output: out/cortex/law_lab/<timestamp>/journal.md, best.nomos, lawNN.nomos
      "name": "law lab: my laws (files, no API)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.law_lab",
      "args": ["--proposer", "files", "--laws", "laws/atlas_ghost.nomos",
               "laws/atlas_habit.nomos", "--holdout", "8-15", "--jobs", "8"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "law lab: rng control",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.law_lab",
