{
  // F5 launch configs for the vivarium playground (and nomos).
  // All use the project's .venv interpreter explicitly, so they work no matter
  // which interpreter VS Code has selected.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "vivarium: watch (pygame)",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.app",
      "args": ["--size", "96", "--seed", "1", "--cell", "7"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "vivarium: watch NCA brains (pygame)",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.app",
      "args": ["--brain", "nca", "--size", "48", "--seed", "1", "--cell", "12",
               "--population", "25"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "vivarium: watch NCA brains (continue from session)",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.app",
      "args": ["--brain", "nca", "--size", "48", "--seed", "1", "--cell", "12",
               "--population", "25",
               "--load-genomes", "vivarium/pools/session.json",
               "--save-genomes", "vivarium/pools/session.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "vivarium: headless NCA run",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.run",
      "args": ["--brain", "nca", "--size", "48", "--seed", "1",
               "--population", "25", "--wall-density", "0",
               "--ticks", "4000", "--every", "250"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "vivarium: watch seeded (from pool)",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.app",
      "args": ["--seed", "5", "--cell", "7",
               "--load-genomes", "vivarium/pools/open_evolved.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "vivarium: headless run",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.run",
      "args": ["--ticks", "8000", "--every", "500", "--seed", "1"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "vivarium: evolve open + save pool",
      "type": "debugpy",
      "request": "launch",
      "module": "vivarium.run",
      "args": ["--ticks", "12000", "--every", "1000", "--seed", "1",
               "--wall-density", "0",
               "--save-genomes", "vivarium/pools/open_evolved.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "aqua: watch continuous NCA (pygame)",
      "type": "debugpy",
      "request": "launch",
      "module": "aqua.app",
      "args": ["--brain", "nca", "--size", "48", "--seed", "1", "--cell", "12",
               "--population", "18"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "aqua: watch continuous NEAT (pygame)",
      "type": "debugpy",
      "request": "launch",
      "module": "aqua.app",
      "args": ["--brain", "neat", "--size", "48", "--seed", "1", "--cell", "12",
               "--population", "18"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "aqua: watch continuous NCA (continue from session)",
      "type": "debugpy",
      "request": "launch",
      "module": "aqua.app",
      "args": ["--brain", "nca", "--size", "48", "--seed", "1", "--cell", "12",
               "--population", "18",
               "--load-genomes", "aqua/pools/session.json",
               "--save-genomes", "aqua/pools/session.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // PLAY the cortex world yourself (stage 1: walk around, no senses/food yet).
      // W/Up thrust, A/D turn, SPACE pause, P screenshot, H help, ESC quit.
      "name": "cortex: PLAY the world (keyboard)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--seed", "2", "--view", "65", "--cell", "12"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // a wider, zoomed-out view — good for judging the GENERATOR rather than playing
      "name": "cortex: PLAY (wide view, seed 4)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--seed", "4", "--view", "101", "--cell", "8"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // the generator is infinite-capable; --size 0 unbounds it (walk forever)
      "name": "cortex: PLAY (unbounded world)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--seed", "1", "--view", "65", "--cell", "12", "--size", "0"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // WATCH A BRAIN PLAY. B hands the wheel between you and it, V cycles the sheet
      // view, T animates the sub-ticks, - and = change WORLD SPEED (1/20x .. 8x) —
      // slow it right down to watch a thought cross the tissue. Click a cell to open
      // the perceptron behind it.
      "name": "cortex: WATCH a brain play",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--seed", "2", "--view", "65", "--cell", "11", "--brain",
               "--brain-seed", "0", "--think-every", "3"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // EVOLVE a lineage: one agent, one long life at a time, genome carried forward
      "name": "cortex: LINEAGE (evolve a brain)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.lineage",
      "args": ["--generations", "12", "--seeds", "0-1", "--ticks", "12000",
               "--think-every", "3"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // watch the best evolved brain play
      "name": "cortex: WATCH the best brain",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--seed", "2", "--view", "65", "--cell", "11",
               "--load-brain", "out/cortex/best_genome.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // WALK A PROBE ARENA YOURSELF — the same situation the observer scores, live and
      // with the full HUD. Change --probe to corner / door / rubble / poison / patience.
      "name": "cortex: WALK a probe arena",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--probe", "corner", "--view", "33", "--cell", "16", "--no-log"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // ...and watch the BRAIN sit the same exam, with its sheet beside it
      "name": "cortex: WATCH a brain in a probe arena",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--probe", "poison", "--view", "33", "--cell", "16", "--no-log",
               "--load-brain", "out/cortex/best_genome.json", "--think-every", "3"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // SCORE a player on all six probes and write the strip to out/cortex/probes.png
      "name": "cortex: PROBES (reflex baseline)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.probes",
      "args": ["--player", "reflex"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "cortex: PROBES (best evolved brain)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.probes",
      "args": ["--player", "brain", "--load-brain", "out/cortex/best_genome.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // the BASELINE the brain has to beat: a twenty-line reflex, senses only
      "name": "cortex: baseline reflex (8 seeds)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.baseline",
      "args": ["--agent", "reflex", "--seeds", "0-7", "--ticks", "30000"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // the FLOOR: a correlated random walk
      "name": "cortex: baseline random (8 seeds)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.baseline",
      "args": ["--agent", "random", "--seeds", "0-7", "--ticks", "30000"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      // play with the map hidden — the sensorium completeness test
      "name": "cortex: PLAY BLIND (senses only)",
      "type": "debugpy",
      "request": "launch",
      "module": "cortex.app",
      "args": ["--seed", "2", "--view", "65", "--cell", "12", "--blind"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "cortex: tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/test_cortex.py", "-q"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true
    }
  ]
}
