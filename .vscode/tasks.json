{
  // Ctrl+Shift+B runs the default build task (watch the vivarium).
  // Terminal > Run Task... lists the rest.
  "version": "2.0.0",
  "options": { "cwd": "${workspaceFolder}" },
  "presentation": { "reveal": "always", "panel": "dedicated" },
  "tasks": [
    {
      "label": "vivarium: watch",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "vivarium.app", "--seed", "1", "--cell", "7"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "vivarium: headless run",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "vivarium.run", "--ticks", "8000", "--every", "500", "--seed", "1"],
      "problemMatcher": []
    },
    {
      "label": "vivarium: tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest", "tests/test_vivarium.py", "-q"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "all tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest", "tests", "-q"],
      "problemMatcher": []
    },
    {
      // one-time: install the exe builder into the venv
      "label": "vivarium: install PyInstaller",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pip", "install", "pyinstaller"],
      "problemMatcher": []
    },
    {
      // build a standalone Windows exe -> dist/vivarium.exe (run the install task first).
      // --windowed = no console window; --onefile = a single portable exe;
      // --collect-submodules vivarium picks up the lazily-imported genome_io too.
      "label": "vivarium: build exe (PyInstaller)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "PyInstaller", "--noconfirm", "--onefile", "--windowed",
               "--name", "vivarium",
               "--paths", "${workspaceFolder}",
               "--collect-submodules", "vivarium",
               "${workspaceFolder}/vivarium/app.py"],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
