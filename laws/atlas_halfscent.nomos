# Control: the reference wave with the smell's share of the source halved.
# If commitment or habituation help only because they weaken the smell, this
# helps as much.

channel source
channel scent
channel solid
channel value

rule wave:
  when 1
  set value = max(source - 0.5 * scent, max(0.94 * max4(value), 0.916214 * max8(value))) * (1 - solid * (1 - leak))
