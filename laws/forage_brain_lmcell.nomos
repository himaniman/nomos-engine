# v1 LM-CELL forage brain: every cell is a tiny 2-layer network that LEARNS
# online by a local, reward-modulated Hebbian rule — no gradients, no PyTorch,
# all in the DSL. This is the "cell = small perceptron" idea, minimal form.
#
# Design (the safe reservoir/extreme-learning trick):
#  - HIDDEN layer = a FIXED RANDOM projection. Each cell's hidden weights are
#    init'd to per-cell random values (uniform(-1,1), different every cell
#    because init sees the world RNG) and NEVER change. A random nonlinear
#    feature bank — cheap, and it keeps the learning stable (only the readout
#    moves, so Hebbian drift can't corrupt the features).
#  - READOUT = LEARNED. The hidden->motor and hidden->avoid weights start tiny
#    (+ noise to break symmetry) and adapt by THREE-FACTOR Hebb:
#        dV = lr * reward * pre(hidden) * post(output)   (minus a small decay)
#    so a readout weight grows only when its hidden unit AND its output fired
#    AND a meal followed (the global `reward` pulse) — the brain strengthens
#    exactly the pathways that led to eating. Weights diverge cell-by-cell from
#    a shared start, so the sheet DIFFERENTIATES through experience.
#
# The direct `+ food` / `+ wall` terms keep the untrained brain at the reactive
# baseline (it still forages before it has learned anything); learning only
# adds structure on top. Snapshot semantics mean signals cross one layer per
# tick (food->hidden->readout->learn), which the 32 ticks/move easily cover.

channel food
channel wall
channel sight
channel temperature
channel reward
channel motor
channel avoid

# fixed random hidden projection (set once at init, never learned)
channel wh0_food: init uniform(-1, 1)
channel wh0_sight: init uniform(-1, 1)
channel wh0_wall: init uniform(-1, 1)
channel wh1_food: init uniform(-1, 1)
channel wh1_sight: init uniform(-1, 1)
channel wh1_wall: init uniform(-1, 1)
channel h0: init 0
channel h1: init 0

# learned readout weights (small + noise to break symmetry)
channel vm0: init uniform(0, 0.4)
channel vm1: init uniform(0, 0.4)
channel va0: init uniform(0, 0.4)
channel va1: init uniform(0, 0.4)

rule hidden:
  when 1
  set h0 = tanh(wh0_food*food + wh0_sight*sight + wh0_wall*wall)
  set h1 = tanh(wh1_food*food + wh1_sight*sight + wh1_wall*wall)

# Only a WEAK hardwired drive (0.4*food) so the untrained brain forages enough
# to earn the shaping reward; the bulk of the motor comes from the LEARNED
# readout of the hidden features, so as the weights adapt the behaviour
# genuinely changes (v1's hardwired food+2*sight drowned the readout — learning
# was inert). lr is up to 0.15 and the dense shaped reward drives it.
rule readout:
  when 1
  set motor = max(0, 0.4*food + vm0*h0 + vm1*h1)
  set avoid = max(0, 0.4*wall + va0*h0 + va1*h1)

# Hunger-gated exploration specks: when starving and the readout is quiet, a few
# random motor points keep the creature MOVING so it stumbles onto food, earns
# the shaping reward, and bootstraps its learning. Without this the brain can
# sit at zero on boards where it never happens to approach food early.
rule explore:
  when temperature > 0.3
  add motor = 0.15 * bernoulli(0.003) * temperature

rule learn:
  when 1
  set vm0 = clamp(vm0 + 0.15*reward*h0*motor - 0.002*vm0, -3, 3)
  set vm1 = clamp(vm1 + 0.15*reward*h1*motor - 0.002*vm1, -3, 3)
  set va0 = clamp(va0 + 0.15*reward*h0*avoid - 0.002*va0, -3, 3)
  set va1 = clamp(va1 + 0.15*reward*h1*avoid - 0.002*va1, -3, 3)
