# The painted smell is a phantom place: right in direction, wrong in position, and it flips between the two ways round a wall, so as a target it traps the agent; yet the ablation says smell doubles the take on some worlds. Here smell stops being a target (only a weak direct pull is left) and becomes a COMPASS: a wall-blind halo around its painted spot multiplies the frontier marks that lie its way, so the agent always walks to real, reachable unknown ground, but chooses the unknown in the direction of the food.

channel source
channel solid
channel free
channel thing
channel scent
channel here
channel value
channel unknown
channel vast
channel confinement
channel dwell
channel frust
channel compass
channel injection

rule unknown:
  when 1
  set unknown = (0.8696 - free) * (1 - solid)

rule vast:
  when 1
  set vast = 0.3 * unknown + 0.8306 * avg8(vast)

rule confine:
  when 1
  set confinement = sum8(solid)

rule dwell:
  when 1
  set dwell = where(here > 0, min(1, dwell + 0.005203), 0.7418 * dwell)

rule frust:
  when 1
  set frust = max(here * dwell, 0.95 * max8(frust))

# the smell as a broad halo around its painted spot, ignoring walls (a direction, not a place)
rule compass:
  when 1
  set compass = max(scent, 0.85 * max8(compass))

# smell no longer pulls on its own: it brightens the frontier that lies its way
rule inject:
  when 1
  set injection = max(max(thing, where(thing > 0, 1.358 * source, 0), 0.3 * scent, where(thing + scent > 0, 0, source * (0.4275 + 1.5 * vast) * (1 + 3 * compass))) / (1 + 0.4454 * confinement), frust * solid * max8(free) * leak)

rule wave:
  when 1
  set value = max(injection, max(0.94 * max4(value), 0.916214 * max8(value)) * (0.85 + 0.15 * min(1, free))) * (1 - solid * (1.028 - leak))
