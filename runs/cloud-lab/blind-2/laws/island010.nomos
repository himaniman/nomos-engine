# The map only spans 25x25 cells and forgets, so the agent has no sense of where it has already been and its frontier choice can lead it back into ground it just emptied of food. A slowly fading `trail` of the walked path, blurred wide into `been`, discounts frontier marks on the side the agent came from, so exploration becomes a sweep that keeps moving away from its own past into fresh ground where uneaten food is.

channel source
channel solid
channel free
channel thing
channel scent
channel here
channel value
channel unknown
channel vast
channel confinement
channel dwell
channel frust
channel trail
channel been
channel injection

rule unknown:
  when 1
  set unknown = (0.8696 - free) * (1 - solid)

rule vast:
  when 1
  set vast = 0.3 * unknown + 0.8306 * avg8(vast)

rule confine:
  when 1
  set confinement = sum8(solid)

rule dwell:
  when 1
  set dwell = where(here > 0, min(1, dwell + 0.005203), 0.7418 * dwell)

rule frust:
  when 1
  set frust = max(here * dwell, 0.95 * max8(frust))

# the path walked, slowly fading; scrolls with the map
rule trail:
  when 1
  set trail = max(here, 0.998 * trail)

# a wide blur of the path: how much of the agent's own past lies around a cell
rule been:
  when 1
  set been = 0.2 * trail + 0.8 * avg8(been)

# frontier on the side the agent came from counts less: the sweep goes on away from its past
rule inject:
  when 1
  set injection = max(max(thing, source * where(thing + scent > 0, 1.358, (0.4275 + 1.5 * vast) * (1 - min(1, 3 * been)))) / (1 + 0.4454 * confinement), frust * solid * max8(free) * leak)

rule wave:
  when 1
  set value = max(injection, max(0.94 * max4(value), 0.916214 * max8(value)) * (0.85 + 0.15 * min(1, free))) * (1 - solid * (1.028 - leak))
