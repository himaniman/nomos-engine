# The harness's map forgets a seen cell in ~1000 ticks, after which the same ground comes back as frontier and pulls the agent to re-explore it, and forgotten walls come back as frontier the agent walks into. The law keeps its OWN slower memory of what was ever seen free (`seen`) and solid (`wall`): a frontier mark on ground the law still remembers is hushed, the unexplored-space blur and confinement read the remembered map, and trust in known ground uses it too, so exploration is spent on ground truly never seen.

channel source
channel solid
channel free
channel thing
channel scent
channel here
channel value
channel seen
channel wall
channel unknown
channel vast
channel confinement
channel dwell
channel frust
channel injection

# the law's own, slower memory of the map: what was ever seen free, what was ever seen solid
rule seen:
  when 1
  set seen = max(free, 0.9998 * seen)

rule wall:
  when 1
  set wall = max(solid, 0.9998 * wall)

# truly unexplored = neither remembered free nor remembered solid
rule unknown:
  when 1
  set unknown = max(0, 0.8696 - seen) * (1 - wall)

rule vast:
  when 1
  set vast = 0.3 * unknown + 0.8306 * avg8(vast)

rule confine:
  when 1
  set confinement = sum8(wall)

rule dwell:
  when 1
  set dwell = where(here > 0, min(1, dwell + 0.005203), 0.7418 * dwell)

rule frust:
  when 1
  set frust = max(here * dwell, 0.95 * max8(frust))

# a frontier mark the harness raised only because ITS map forgot is hushed by the law's memory
rule inject:
  when 1
  set injection = max(max(thing, source * where(thing + scent > 0, 1.027, (0.4275 + 1.5 * vast) * (1 - min(1, 2 * max(seen - free, wall - solid))))) / (1 + 0.5 * confinement), frust * solid * max8(free) * leak)

rule wave:
  when 1
  set value = max(injection, max(0.94 * max4(value), 0.916214 * max8(value)) * (0.85 + 0.15 * min(1, max(free, seen)))) * (1 - solid * (1.028 - leak))
