# Every law so far plans with a max() wave: each cell sees only its single best target, so one berry pulls exactly as hard as a cluster of three, one frontier crack as hard as a long open edge, and between two near-equal targets the agent can rock. This law replaces the wave with a POTENTIAL FIELD: each cell relaxes toward the slightly discounted MEAN of its eight neighbours (walls absorb by their leak), so the pulls of all sources add up, the field is smooth with no plateaus or ties, and the agent heads to where the most food and unknown lie together. Same senses and injection as the best law; only the planning physics changes.

channel source
channel solid
channel free
channel thing
channel scent
channel here
channel value
channel unknown
channel vast
channel confinement
channel dwell
channel frust
channel injection

# what is neither known solid nor known free; its blur = unexplored space around a cell
rule unknown:
  when 1
  set unknown = (0.8696 - free) * (1 - solid)

rule vast:
  when 0.9921
  set vast = 0.3 * unknown + 0.8306 * avg8(vast)

rule confine:
  when 1
  set confinement = sum8(solid)

# time spent on a cell grows under the agent and fades elsewhere (scrolls with the map)
rule dwell:
  when 1
  set dwell = where(here > 0, min(1, dwell + 0.005203), 0.7418 * dwell)

# frustration: the dwell under the agent, broadcast over the map with a discount
rule frust:
  when 1
  set frust = max(here * dwell, 0.95 * max8(frust))

# frustrated: known wall faces (solid touching known free) become targets, likelier doors first
rule inject:
  when 1
  set injection = max(max(thing, source * where(thing + scent > 0, 1.027, 0.4275 + 1.5 * vast)) / (1 + 0.5 * confinement), frust * solid * max8(free) * leak)

# a POTENTIAL FIELD instead of a wave: each cell relaxes to the (slightly discounted) MEAN of
# its neighbours, walls absorb by their leak; sources add up, so many marks pull harder than one
rule potential:
  when 1
  set value = max(injection, 0.995 * avg8(value) * (0.85 + 0.15 * min(1, free))) * (1 - solid * (1.028 - leak))
