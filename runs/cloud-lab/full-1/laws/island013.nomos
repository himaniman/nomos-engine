# The smell is repainted from scratch every thought at a waypoint whose bearing flips between the two ways round a wall, so food-directed walks can dither even with the footprint trail; the plain ghost helped the bare wave by +4 meals but was never tried on top of darkness-weighted exploration. Here only FOOD evidence (smell and seen morsels) lingers in its own NOSE channel, erased when the agent reaches the spot or when it is marked bad, while frontier marks stay instantaneous, so a food target once chosen is held through the flip but exploration still follows the live map.

channel source
channel solid
channel free
channel thing
channel scent
channel bad
channel here
channel value
channel dark
channel nose
channel injection
channel wave
channel trail

rule track:
  when 1
  set trail = max(here, 0.97 * trail)

rule darkness:
  when 1
  set dark = 0.5 * (1 - free) * (1 - solid) + 0.5 * avg8(dark)

# smell and seen morsels LINGER where they were painted (a flipping bearing keeps its first target);
# reaching the place, or learning it is bad, erases the ghost
rule linger:
  when 1
  set nose = max(scent, thing * (1 - bad), 0.99 * nose) * (1 - max(here, max8(here))) * (1 - bad)

# frontier by darkness as before; food is the lingering nose, so a target once chosen is held
rule inject:
  when 1
  set injection = max(nose, where(scent + thing < 0.05, source, 0) * (0.3 + 2.0 * dark)) / (1 + 0.5 * sum8(solid))

rule plan:
  when 1
  set wave = max(injection, max(0.94 * max4(wave), 0.916214 * max8(wave))) * (1 - solid * (1 - leak))

rule read:
  when 1
  set value = wave * (1 - 0.4 * trail)
