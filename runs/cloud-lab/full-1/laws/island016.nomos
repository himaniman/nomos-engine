# The persistent max-wave never forgets fast enough: when a morsel is eaten or a smell waypoint moves, its old peak leaves a flat plateau that decays only as fast as it spreads, so for several thoughts every neighbour ties and the gradients of the real current sources are hidden under it (the agent walks blind straight ahead after each meal). A FRESH plan wiped on the first pass of every thought (a life clock gives the phase) and rebuilt from what is sensed now is added to a scaled-down persistent wave that keeps the long view, so the near decision always follows live evidence while the far guidance survives.

channel source
channel solid
channel free
channel thing
channel scent
channel bad
channel here
channel value
channel dark
channel clock
channel injection
channel fresh
channel wave
channel trail

rule tick:
  when 1
  set clock = max(clock, max8(clock)) + 1

rule track:
  when 1
  set trail = max(here, 0.97 * trail)

rule darkness:
  when 1
  set dark = 0.5 * (1 - free) * (1 - solid) + 0.5 * avg8(dark)

rule inject:
  when 1
  set injection = max(where(scent + thing < 0.05, 0, source), thing * (1 - bad), where(scent + thing < 0.05, source, 0) * (0.3 + 2.0 * dark)) / (1 + 0.5 * sum8(solid))

# a plan rebuilt from scratch every thought (wiped on its first pass): only what is sensed NOW, out to ~5 cells
rule replan:
  when 1
  set fresh = where(clock % 6 < 0.5, 0, max(injection, max(0.94 * max4(fresh), 0.916214 * max8(fresh))) * (1 - solid * (1 - leak)))

# the persistent wave keeps the long view (and its stale plateaus)
rule plan:
  when 1
  set wave = max(injection, max(0.94 * max4(wave), 0.916214 * max8(wave))) * (1 - solid * (1 - leak))

# read the fresh near plan, with the long view added underneath as a guide where nothing is near
rule read:
  when 1
  set value = (fresh + 0.3 * wave) * (1 - 0.4 * trail)
