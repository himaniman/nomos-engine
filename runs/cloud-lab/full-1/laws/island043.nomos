# Removing the read-out dimming cost 3.5 meals (#42: 25.1 vs #35: 28.8), so the trail must act at the decision, and the plan price alone cannot stop the shuttle. The other old load-bearing piece, confinement, sees only the eight cells around a source: a source in a single nook of an open field and one deep inside a cave or maze count alike. Adding the solidity of the next ring out at half weight makes confinement a two-scale measure, so deep enclosed sources (and their dead ends) are discounted more than nooks in open ground.

channel source
channel solid
channel free
channel thing
channel scent
channel bad
channel here
channel leak
channel value
channel dark
channel guess
channel door
channel open
channel crowd
channel injection
channel wave
channel trail

rule track:
  when 1
  set trail = max(here, 0.97 * trail)

rule darkness:
  when 1
  set dark = 0.5 * (1 - free) * (1 - solid) * (1 - guess) + 0.5 * avg8(dark)

rule complete:
  when 1
  set guess = (1 - free) * (1 - solid) * max(shift(solid, 1, 0) * shift(solid, -1, 0), shift(solid, 0, 1) * shift(solid, 0, -1), 0.6 * shift(solid, 1, 0) * shift(solid, 2, 0), 0.6 * shift(solid, -1, 0) * shift(solid, -2, 0), 0.6 * shift(solid, 0, 1) * shift(solid, 0, 2), 0.6 * shift(solid, 0, -1) * shift(solid, 0, -2))

# the other half of map completion: an unknown cell that continues a line of open floor is probably floor
rule open_floor:
  when 1
  set open = (1 - free) * (1 - solid) * (1 - guess) * max(shift(free, 1, 0) * shift(free, -1, 0), shift(free, 0, 1) * shift(free, 0, -1), 0.6 * shift(free, 1, 0) * shift(free, 2, 0), 0.6 * shift(free, -1, 0) * shift(free, -2, 0), 0.6 * shift(free, 0, 1) * shift(free, 0, 2), 0.6 * shift(free, 0, -1) * shift(free, 0, -2))

# a wall cell whose taught leak exceeds the walls around it stands out as a door
rule doorness:
  when 1
  set door = clamp(leak + 2.0 * (leak - sum8(solid * leak) / (sum8(solid) + 0.01)) * min(1, 0.5 * sum8(solid)), 0, 1)

# solidity of the neighbourhood one ring further out: how walled-in the wider surroundings are
rule crowding:
  when 1
  set crowd = avg8(solid)

# confinement counts the near ring and, at half weight, the wider one: a source deep in a cave or maze counts less than one in a nook of an open field
rule inject:
  when 1
  set injection = max(where(scent + thing < 0.05, 0, source), thing * (1 - bad), where(scent + thing < 0.05, source, 0) * (0.3 + 2.0 * dark) * (1 - guess)) / (1 + 0.5 * sum8(solid) + 0.25 * sum8(crowd))

# the whole map priced by knowledge: unknown ground costs unless predicted floor, guessed wall passes half, a seen wall passes by its door contrast
rule plan:
  when 1
  set wave = max(injection, (1 - 0.08 * (1 - max(free, open))) * max(0.94 * max4(wave), 0.916214 * max8(wave))) * (1 - solid * (1 - door)) * (1 - 0.5 * guess)

rule read:
  when 1
  set value = wave * (1 - 0.4 * trail)
