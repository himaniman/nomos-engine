# Axis: the far-vs-near trade-off. One wave gives every source the same 0.94/cell horizon, so a wide frontier ten cells away competes with a narrow one beside the agent and it zig-zags across the map instead of sweeping it. Here food (the source with the harness's 0.12 frontier marks subtracted, lingering) and exploration run as two separate waves with separate horizons — food far-sighted at 0.94/cell, exploration short-sighted at 0.85/cell — and the agent follows the larger; #7's frustration (dwell-opened walls, lifted confinement) and trail are kept as the shared conductance, so nearest-frontier sweeping is the only change.

channel source
channel thing
channel solid
channel free
channel here
channel bad
channel leak
channel value
channel ghost: init 0
channel confinement
channel unk
channel room
channel front
channel trail: init 0
channel dwell: init 0
channel crowd: init 0
channel conduct
channel fwave
channel xwave

rule lay_trail:
  when 1
  set trail = max(here, 0.999 * trail)
rule dwell_time:
  when 1
  set dwell = min(1, 0.998 * dwell + 0.02 * here)
rule frustration:
  when 1
  set crowd = 0.5 * dwell + 0.5 * avg8(crowd)
rule unknown:
  when 1
  set unk = (free < 0.2) * (solid < 0.5)
rule roominess:
  when 1
  set room = 0.5 * unk + 0.5 * avg8(room)
# the harness's own frontier, recomputed: unknown touching known-free
rule frontier:
  when 1
  set front = unk * (max8(free) > 0.5)
rule calc_conf:
  when 1
  set confinement = sum8(solid)
# how much wave a cell lets through (frustration opens walls, walked ground resists a little)
rule conductance:
  when 1
  set conduct = (1 - solid * (1 - min(1, leak * (1 + 3 * crowd)))) * (1 - 0.08 * trail)

# FOOD alone: the source with the harness's 0.12 frontier marks taken out, lingering
rule linger:
  when 1
  set ghost = max(source - 0.12 * front, thing, 0.99 * ghost) * (1 - here) * (1 - max8(here)) * (1 - bad)

# two waves with their own horizons: food carries far (0.94/cell) ...
rule food_wave:
  when 1
  set fwave = max(ghost / (1 + 0.5 * confinement * (1 - crowd)), max(0.94 * max4(fwave), 0.916214 * max8(fwave))) * conduct
# ... exploration is short-sighted (0.85/cell): sweep the nearest wide frontier, not a far one
rule explore_wave:
  when 1
  set xwave = max(max(0.3 * front * room * room, 0.04 * unk) / (1 + 0.5 * confinement * (1 - crowd)), max(0.85 * max4(xwave), 0.7943 * max8(xwave))) * conduct

rule combine:
  when 1
  set value = max(fwave, xwave)
