# One wave mixes two different wants — food it smells or sees, and unknown ground to explore — so a regrowing patch nearby always outshines the faint frontier and the agent grazes one loop for thousands of ticks (observer, world 7). Here they are two separate waves, FOOD and EXPLORE, and a slow GRAZE field (stamped where the agent walks, diffused, fading over hundreds of ticks) discounts the food wave only where the agent has already been grazing; after a few laps of a patch the explore wave wins and the agent leaves for unseen country, and returns once the boredom has faded and the patch has regrown.

channel source
channel solid
channel free
channel thing
channel scent
channel here
channel value
channel void: init 0
channel graze: init 0
channel confinement
channel food
channel explore

# How much undiscovered country surrounds a cell, diffused and remembered.
rule unknown_mass:
  when 1
  set void = clamp(0.7 * avg8(void) + 0.3 * (1 - free) * (1 - solid), 0, 1)

# Boredom: stamped where the agent walks, spread over the patch, fading slowly.
rule grazing:
  when 1
  set graze = clamp(0.9995 * (0.6 * graze + 0.4 * avg8(graze)) + 0.03 * here, 0, 1)

# Local confinement, as in the best law.
rule calc_conf:
  when 1
  set confinement = sum8(solid)

# The food wave: only what is smelled or seen.
rule food_wave:
  when 1
  set food = max(where(scent + thing > 0, source, 0) / (1 + 0.5 * confinement), max(0.94 * max4(food), 0.916214 * max8(food))) * (1 - solid * (1 - leak))

# The explore wave: only frontier marks, weighted by the unknown behind them.
rule explore_wave:
  when 1
  set explore = max(where(scent + thing > 0, 0, source) * (0.5 + 1.5 * void) / (1 + 0.5 * confinement), max(0.94 * max4(explore), 0.916214 * max8(explore))) * (1 - solid * (1 - leak))

# Food is worth less where I have been grazing; the stronger want leads.
rule decide:
  when 1
  set value = max(food * (1 - 0.8 * graze), explore)
